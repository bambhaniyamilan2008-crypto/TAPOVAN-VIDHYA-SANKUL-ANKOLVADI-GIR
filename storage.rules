rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Anyone can view images, only admin can upload/delete
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}